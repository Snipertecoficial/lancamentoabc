<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Flag panel URLs (no [L], URL untouched) so mod_headers can add X-Robots-Tag below.
  RewriteRule ^(login|painel)(/|$) - [E=PANEL_NOINDEX:1,NC]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Keep the admin panel out of search engines at the server level (the SPA also sets a noindex meta).
# Only directives valid on Apache 2.2 and 2.4.
<IfModule mod_headers.c>
  SetEnvIfNoCase Request_URI "^/(login|painel)(/|$)" PANEL_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=PANEL_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_PANEL_NOINDEX
</IfModule>
