<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Keep the admin panel out of search engines at the server level (the SPA also sets a noindex meta).
# Matches /login and /painel (any case, with or without a trailing path); the rewrite above still serves index.html.
<IfModule mod_headers.c>
  # Expression-based: evaluated on the original request URI, so the internal rewrite to /index.html does not matter.
  Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} =~ m#^/(login|painel)(/|$)#i"
  # Fallback via env var (REDIRECT_ prefix is what Apache gives it after an internal redirect).
  SetEnvIf Request_URI "(?i)^/(login|painel)(/|$)" PANEL_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=PANEL_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_PANEL_NOINDEX
</IfModule>
